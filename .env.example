# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Trên GitHub Actions thì đặt cùng tên này trong Settings → Secrets and variables → Actions.

# Telegram — lấy từ @BotFather
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ISOD — API key lấy trong portal isod.ee.pw.edu.pl
ISOD_USERNAME=""
ISOD_API_KEY=""

# Upstash Redis — để persist trạng thái giữa các lần chạy cron
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Tuỳ chọn: giây giữa 2 lần kiểm tra (mặc định 120)
# CHECK_INTERVAL="120"
